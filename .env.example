# ConnectWise PSA (Manage) — set real values in Vercel, never commit them.
CW_HOST=api-na.myconnectwise.net
CW_API_PATH=v4_6_release/apis/3.0
CW_COMPANY_ID=
CW_PUBLIC_KEY=
CW_PRIVATE_KEY=
CW_CLIENT_ID=

# Bridge security
BRIDGE_API_TOKEN=            # long random string: openssl rand -base64 48
WRITES_ENABLED=false         # must be exactly "true" to enable write tools
ALLOWED_ORIGINS=             # comma-separated browser origins allowed to call the API (blank = none)

# Optional
RATE_LIMIT_PER_MINUTE=120    # per bearer token, per serverless instance
CW_MISC_CATALOG_ITEM_ID=     # catalog item used for custom (non-catalog) sales lines
