# Inflatable Office (rental.software API6). Settings > API Keys. Set real values in Vercel, never commit them.
IO_API_KEY=
IO_DEFAULT_ZIP=              # used when a GHL booking's contact has no zip (IO requires eventzip)
IO_CONFIRMED_STATUS=         # optional: exact IO lead status name for GHL "confirmed" (e.g. Confirmed)
IO_CANCEL_STATUS=            # optional: exact IO lead status name for GHL "cancelled" (e.g. Cancelled)

# GoHighLevel sub-account (Lead Alchemist). Sub-account Settings > Private Integrations
GHL_TOKEN=
GHL_LOCATION_ID=
GHL_CALENDAR_ID=             # the calendar IO events are booked on
GHL_SYNC_TAG=inflatable-office
GHL_NOTIFY=false             # true = GHL sends its own appointment notifications for synced events
GHL_CONTACTS_VERSION=2021-07-28
GHL_CALENDARS_VERSION=2021-04-15

# Optional: mirror IO leads as opportunities in a pipeline
GHL_PIPELINE_ID=
GHL_DEFAULT_STAGE_ID=
GHL_STAGE_MAP=               # JSON: {"Quote":"<stageId>","Confirmed":"<stageId>"}

# Inbound auth. Generate each with: openssl rand -hex 32
IO_WEBHOOK_SECRET=
GHL_WEBHOOK_SECRET=
CRON_SECRET=

# Store. Add Upstash Redis from the Vercel Marketplace (it sets these for you)
KV_REST_API_URL=
KV_REST_API_TOKEN=
